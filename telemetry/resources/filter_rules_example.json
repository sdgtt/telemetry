{
  "version": "2.0",
  "description": "Test filter rules - filter out dmesg_warn, keep only dmesg_err",
  "rules": [
    {
      "type": "dmesg_warn",
      "pattern": ".*",
      "match_type": "regex",
      "action": "drop",
      "description": "Drop ALL dmesg_warn messages - test filtering"
    },
    {
      "type": "dmesg_err",
      "pattern": ".*",
      "match_type": "regex",
      "action": "keep",
      "description": "Keep all dmesg_err messages"
    }
  ]
}
